# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PURE POSTGRESQL DATABASE (Neon / Render / Cloud PostgreSQL)
# Example: postgresql://username:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@hostname:5432/akngroup_db?sslmode=require"

# ADMIN AUTHENTICATION & SECURITY (16+ character strong password, 32+ character non-placeholder JWT secret)
ADMIN_PASSWORD="YourSecureAdminPassword2026!"
ADMIN_JWT_SECRET="your_strong_admin_jwt_secret_key_min_32_characters_here"
MEMBER_JWT_SECRET="your_strong_member_jwt_secret_key_min_32_characters_here"
